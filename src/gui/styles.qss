QMainWindow { background: #0F172A; }
QWidget { color: #F8FAFC; background: transparent; font: 10pt "Segoe UI"; }
QFrame#hero { background: transparent; border: 0; }
QLabel#title { color: #F8FAFC; font-size: 16pt; font-weight: 700; }
QLabel#subtitle { color: #94A3B8; font-size: 9pt; }
QWidget#sidebar {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}
QGroupBox {
    color: #F8FAFC;
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 7px;
    margin-top: 12px;
    padding: 12px 8px 7px;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #94A3B8;
    font-size: 8pt;
    font-weight: 700;
}
QLabel#fieldLabel { color: #94A3B8; font-size: 8pt; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    color: #F8FAFC;
    background: #0F172A;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 4px 6px;
    min-height: 19px;
    selection-background-color: #2563EB;
}
QSpinBox, QDoubleSpinBox { padding-right: 22px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: #1E293B;
    border-left: 1px solid #334155;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
    border-bottom: 1px solid #334155;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("icons/chevron-up.svg"); width: 9px; height: 9px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("icons/chevron-down.svg"); width: 9px; height: 9px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #1D4ED8; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed { background: #2563EB; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextBrowser:focus { border: 1px solid #3B82F6; }
QComboBox::drop-down { border: 0; width: 20px; }
QComboBox QAbstractItemView {
    color: #F8FAFC;
    background: #1E293B;
    selection-background-color: #1D4ED8;
    border: 1px solid #334155;
}
QPlainTextEdit, QTextBrowser, QTableWidget {
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    background: #1E293B;
    alternate-background-color: #263449;
}
QTextBrowser { padding: 10px; }
QTableWidget { gridline-color: #334155; }
QHeaderView::section {
    color: #CBD5E1;
    background: #1E293B;
    border: 0;
    border-bottom: 2px solid #2563EB;
    padding: 7px;
    font-weight: 700;
}
QPushButton {
    color: #F8FAFC;
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 6px 9px;
    font-weight: 600;
}
QPushButton:hover { background: #263449; border-color: #3B82F6; }
QPushButton:pressed { background: #1D4ED8; }
QPushButton#start { color: #FFFFFF; background: #2563EB; border: 1px solid #2563EB; font-weight: 700; }
QPushButton#start:hover { background: #1D4ED8; border-color: #1D4ED8; }
QPushButton#start:disabled { color: #CBD5E1; background: #334155; }
QPushButton:disabled { color: #64748B; background: #1E293B; border-color: #263449; }
QTabWidget::pane { background: #1E293B; border: 1px solid #334155; border-radius: 0 0 6px 6px; top: -1px; }
QTabBar { background: transparent; border-bottom: 1px solid #334155; }
QTabBar::tab {
    color: #94A3B8;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 8px 11px 7px;
    margin-right: 5px;
}
QTabBar::tab:hover { color: #F8FAFC; background: #1E293B; }
QTabBar::tab:selected { color: #F8FAFC; border-bottom: 2px solid #3B82F6; font-weight: 700; }
QProgressBar {
    color: #CBD5E1;
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    min-width: 150px;
    min-height: 18px;
    font-weight: 600;
}
QProgressBar::chunk { background: #2563EB; border-radius: 3px; }
QStatusBar { color: #94A3B8; background: #0F172A; border-top: 1px solid #1E293B; }
QLabel#statusTag {
    color: #CBD5E1;
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 7px;
    font-size: 8pt;
}
QLabel#statusTag[warning="true"] { color: #FBBF24; border-color: #92400E; }
QScrollArea { border: 0; background: transparent; }
QScrollBar:vertical { background: #0F172A; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #334155; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #475569; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #0F172A; height: 9px; margin: 0; }
QScrollBar::handle:horizontal { background: #334155; min-width: 24px; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #475569; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
