QMainWindow { background: #fafafa; }
QWidget { font: 10pt "Segoe UI"; }
QLabel#title { font-size: 17pt; font-weight: 600; }
QGroupBox { border: 1px solid #c9c9c9; margin-top: 10px; padding: 10px 4px 4px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; }
QLineEdit, QPlainTextEdit, QTextBrowser, QTableWidget {
    border: 1px solid #c9c9c9;
    background: white;
}
QTextBrowser { padding: 10px; }
QPushButton { background: #eeeeee; border: 1px solid #b6b6b6; padding: 4px 8px; }
QPushButton#start { font-weight: 600; }
QPushButton:hover { background: #e1e1e1; }
QPushButton:focus { border-color: #555555; }
QPushButton:disabled { color: #888888; background: #f5f5f5; }
QTabBar::tab { background: #eeeeee; border: 1px solid #c9c9c9; padding: 5px 9px; }
QTabBar::tab:selected { background: white; font-weight: 600; }
QProgressBar { border: 1px solid #c9c9c9; text-align: center; min-width: 145px; }
QProgressBar::chunk { background: #bfc8cc; }
