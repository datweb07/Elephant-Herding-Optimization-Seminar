QMainWindow, QWidget { background: #f5f7fb; color: #1e293b; font: 10pt "Segoe UI"; }
QLabel#title { font-size: 24pt; font-weight: 700; color: #142847; padding-top: 8px; }
QGroupBox { font-weight: 600; border: 1px solid #d5deeb; border-radius: 7px; margin-top: 14px; padding: 16px 8px 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextBrowser, QTableWidget {
    background: white; border: 1px solid #d5deeb; border-radius: 4px; padding: 4px;
}
QTextBrowser { padding: 20px; }
QPushButton { background: #e8eef7; border: 1px solid #d5deeb; border-radius: 5px; padding: 8px; }
QPushButton#start { background: #2359a9; color: white; font-weight: 600; }
QPushButton:hover { border-color: #2359a9; }
QPushButton:disabled, QPushButton#start:disabled { color: #64748b; background: #e4e8ee; }
QTabBar::tab { background: #e8eef7; padding: 10px 14px; margin-right: 2px; }
QTabBar::tab:selected { background: white; color: #2359a9; }
QProgressBar { border: 1px solid #d5deeb; border-radius: 4px; text-align: center; min-width: 160px; }
QProgressBar::chunk { background: #a9c9f3; }
