# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and distribution
build/
dist/
*.egg-info/
.eggs/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace

# Environment variables / local secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Generated experiments and charts
outputs/
results/generated/
docs/figures/generated/

# Third-party copyrighted book: DO NOT commit the PDF
references/*.pdf
*.pdf

# Exception: intentional PDF deliverables may be added with `git add -f`
# only after reviewing permissions, or relax the pattern for team-authored PDFs.
